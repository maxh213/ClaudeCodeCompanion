modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "run_claude_agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WebInterface"

[[workflows.workflow]]
name = "run_claude_agent"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python claude_agent.py --help"

[[workflows.workflow]]
name = "WebInterface"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python run_web_interface.py"
waitForPort = 5000

[deployment]
run = ["sh", "-c", "python claude_agent.py --repo-path ."]

[[ports]]
localPort = 5000
externalPort = 80
